@ECHO OFF
ECHO.
ECHO Current profile: %CONFIG%
ECHO Choose the profile for the NEXT core reset:
ECHO 1 - HIMEM only (default)
ECHO 2 - No memory manager
ECHO 3 - EMM386 upper memory (experimental on FPGA)
ECHO 4 - EMM386 with EMS (experimental on FPGA)
ECHO 5 - VEM486 upper memory (experimental on FPGA)
ECHO 6 - Minimal DOS shell
ECHO S - Keep current configuration
A:\DOS\CHOICE.COM /C:123456S /N "Select: "
IF ERRORLEVEL 7 GOTO END
IF ERRORLEVEL 6 GOTO BARE
IF ERRORLEVEL 5 GOTO VEM
IF ERRORLEVEL 4 GOTO EMS
IF ERRORLEVEL 3 GOTO UMB
IF ERRORLEVEL 2 GOTO NOEMM
SET NEXTCFG=XMS
GOTO SAVE
:NOEMM
SET NEXTCFG=NOEMM
GOTO SAVE
:UMB
SET NEXTCFG=UMB
GOTO SAVE
:EMS
SET NEXTCFG=EMS
GOTO SAVE
:VEM
SET NEXTCFG=VEM
GOTO SAVE
:BARE
SET NEXTCFG=BARE
:SAVE
IF NOT EXIST A:\DOS\FC.EXE GOTO FAILED
IF NOT EXIST A:\PROFILES\%NEXTCFG%.SYS GOTO FAILED
COPY A:\CONFIG.SYS A:\Z98BACK\PREVIOUS.SYS >NUL
A:\DOS\FC.EXE /B A:\CONFIG.SYS A:\Z98BACK\PREVIOUS.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY A:\PROFILES\%NEXTCFG%.SYS A:\CONFIG.SYS >NUL
A:\DOS\FC.EXE /B A:\PROFILES\%NEXTCFG%.SYS A:\CONFIG.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Saved %NEXTCFG%. Reset the core to activate it.
ECHO The current session still uses %CONFIG%.
GOTO END
:FAILED
ECHO Could not save the profile. Check free space and write protection.
:END
SET NEXTCFG=
PAUSE
