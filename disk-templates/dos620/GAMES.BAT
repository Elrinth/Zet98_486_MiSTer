@ECHO OFF
:MENU
A:
CD \
CLS
ECHO Zet98-486 PC-98 game disk
ECHO MS-DOS 6.20   Boot profile: %CONFIG%
ECHO.
ECHO R - Rusty (English)
ECHO N - Nightslave
ECHO D - Doom II
ECHO C - Doom II configuration
ECHO M - Memory details
ECHO P - Change memory profile (takes effect after reset)
ECHO S - DOS shell
ECHO.
A:\DOS\CHOICE.COM /C:RNDCMPS /N "Select: "
IF ERRORLEVEL 7 GOTO END
IF ERRORLEVEL 6 GOTO PROFILE
IF ERRORLEVEL 5 GOTO MEMORY
IF ERRORLEVEL 4 GOTO DOOMCFG
IF ERRORLEVEL 3 GOTO DOOM
IF ERRORLEVEL 2 GOTO NIGHT
IF ERRORLEVEL 1 GOTO RUSTY
GOTO END
:RUSTY
CALL A:\RUSTY.BAT
GOTO MENU
:NIGHT
CALL A:\NIGHT.BAT
GOTO MENU
:DOOM
CALL A:\DOOM2.BAT
GOTO MENU
:DOOMCFG
CD \GAMES\DOOM2
SETUP.EXE
GOTO MENU
:PROFILE
CALL A:\PROFILE.BAT
GOTO MENU
:MEMORY
A:\DOS\MEM.EXE /C
PAUSE
GOTO MENU
:END
A:
CD \
