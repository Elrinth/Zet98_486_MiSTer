@ECHO OFF
ECHO.
ECHO Current profile: %CONFIG%
ECHO Choose the profile for the NEXT core reset:
ECHO 1 - Full extended memory (default)
ECHO 2 - Limited extended memory (14 MB)
ECHO 3 - Conventional memory only
ECHO 4 - Minimal DOS shell
ECHO S - Keep current configuration
A:\DOS\CHOICE.COM /C:1234S /N "Select: "
IF ERRORLEVEL 5 GOTO END
IF ERRORLEVEL 4 GOTO BARE
IF ERRORLEVEL 3 GOTO CONV
IF ERRORLEVEL 2 GOTO LIMITED
SET NEXTCFG=FPGA
GOTO SAVE
:LIMITED
SET NEXTCFG=LIMITED
GOTO SAVE
:CONV
SET NEXTCFG=CONV
GOTO SAVE
:BARE
SET NEXTCFG=BARE
:SAVE
IF NOT EXIST A:\DOS\FC.EXE GOTO FAILED
IF NOT EXIST A:\PROFILES\%NEXTCFG%.SYS GOTO FAILED
COPY A:\CONFIG.SYS A:\Z98BACK\PREVIOUS.SYS >NUL
A:\DOS\FC.EXE /B A:\CONFIG.SYS A:\Z98BACK\PREVIOUS.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY A:\PROFILES\%NEXTCFG%.SYS A:\CONFIG.SYS >NUL
A:\DOS\FC.EXE /B A:\PROFILES\%NEXTCFG%.SYS A:\CONFIG.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Saved %NEXTCFG%. Reset the core to activate it.
ECHO The current session still uses %CONFIG%.
GOTO END
:FAILED
ECHO Could not save the profile. Check free space and write protection.
:END
SET NEXTCFG=
PAUSE
